# Application
NODE_ENV=production
PORT=3000
API_BASE_URL=http://localhost:3000

# Database (PostgreSQL / Supabase)
DATABASE_URL=postgresql://user:password@localhost:5432/murmur

# Redis Event Bus
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ISSUER=murmur-cloud-terminal

# Observability
LOG_LEVEL=info
DD_API_KEY=
DD_APP_KEY=

# Feature flags
ENABLE_WEBSOCKET=true
ENABLE_METRICS=true
